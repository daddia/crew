{
  "name": "crew",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.2",
  "prettier": "@repo/prettier-config",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "pnpm lint:dependencies && pnpm lint:eslint && pnpm guard:invariants",
    "guard:invariants": "pnpm --filter @repo/invariants-guard build && node tooling/invariants-guard/dist/cli.js",
    "lint:eslint": "turbo lint",
    "lint:dependencies": "dependency-cruiser --config .dependency-cruiser.cjs crews packages",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check . --log-level warn",
    "release": "changeset publish",
    "validate": "pnpm validate:build && pnpm validate:quality && pnpm test",
    "validate:build": "pnpm install && pnpm build",
    "validate:quality": "pnpm format && pnpm lint:fix && pnpm lint:dependencies && pnpm typecheck",
    "clean": "turbo clean",
    "reset": "pnpm clean && rm -rf node_modules && pnpm install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@repo/prettier-config": "workspace:*",
    "@types/node": "^26.0.1",
    "dependency-cruiser": "^18.0.0",
    "prettier": "^3.8.5",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@daddia/crew": "file:packages/crew"
    }
  }
}
