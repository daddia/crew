# delivery unit — copy to .env and fill in values

# Server
PORT=3000

# Anthropic
ANTHROPIC_API_KEY=

# Atlassian / Jira
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
ATLASSIAN_BASE_URL=https://yourorg.atlassian.net

# GitLab
GITLAB_PERSONAL_ACCESS_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_PROJECT_ID=

# Webhook secrets
JIRA_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=

# SQLite file location (relative to agents/delivery/)
DB_PATH=./data/delivery.db

# Workflow
# Maximum number of refactor iterations before escalating to human review.
REFACTOR_LOOP_CAP=2
