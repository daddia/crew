# code-reviewer unit — copy to .env and fill in values
# When running in CI, these are provided as masked pipeline variables.

# Anthropic
ANTHROPIC_API_KEY=

# GitLab — bot token with api scope (read MR, post comments)
GITLAB_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4

# Review behaviour
# Maximum number of inline threads to post per MR (default: 10).
MAX_FINDINGS=10
# Minimum severity to post as an inline thread: critical | high | medium | low | note (default: high).
SEVERITY_THRESHOLD=high
# Maximum number of changed files before refusing to review (default: 50).
DIFF_FILE_CAP=50

# Injected automatically by GitLab CI — set manually for local testing.
CI_PROJECT_ID=
CI_MERGE_REQUEST_IID=
