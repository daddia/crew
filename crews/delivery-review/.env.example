# delivery-review crew — copy to .env and fill in values
# See src/config.ts for the canonical schema and validation rules.

# ── Identity ──────────────────────────────────────────────────────────────────
# Unique identifier for this crew instance (default: delivery-review).
CREW_ID=delivery-review

# Jira
ATLASSIAN_BASE_URL=https://your-org.atlassian.net
ATLASSIAN_EMAIL=bot@your-org.example.com
JIRA_PROJECT_KEY=CREW
JIRA_ASSIGNEE_ACCOUNT_ID=5b10ac8d82e05b22cc7d4ef5
# Optional: Atlassian account ID for the bot user (comment attribution).
ATLASSIAN_ACCOUNT_ID=
JIRA_ACCEPTANCE_CRITERIA_FIELD_ID=customfield_10042
# Required: comma-separated Atlassian account IDs allowed to PM-approve.
PM_APPROVER_ACCOUNT_IDS=5b10ac8d82e05b22cc7d4ef5

# GitLab
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_PROJECT_ID=12345678
GITLAB_DEFAULT_BRANCH=main

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Poller interval in milliseconds (default: 300000).
POLL_INTERVAL_MS=300000
# Hours to wait for PM /pm-approve before escalating (default: 48).
PM_REVIEW_TIMEOUT_HOURS=48
# Substring PM comments must contain to count as approval (default: /pm-approve).
PM_APPROVAL_COMMENT_PATTERN=/pm-approve
# Tech-lead agent caps
TECH_LEAD_MAX_TURNS=30
TECH_LEAD_COST_CAP_USD=5
DIFF_FILE_CAP=50
DIFF_SIZE_CAP_BYTES=500000
# Structured log level: debug | info | warn | error (default: info).
LOG_LEVEL=info
# CrewBench fixture mode: mock | live (default: mock).
CREW_EVAL_FIXTURE_MODE=mock

# ── Infrastructure ────────────────────────────────────────────────────────────
# HTTP port. Default: 3002 (delivery-build=3000, delivery-qa=3001).
PORT=3002
# SQLite database file path.
DB_PATH=./data/delivery-review.db

# ── Secrets ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ATLASSIAN_API_TOKEN=your-atlassian-api-token
GITLAB_PERSONAL_ACCESS_TOKEN=glpat-...
JIRA_WEBHOOK_SECRET=your-jira-webhook-secret-min-16-chars
# Optional: Honeycomb API key for distributed tracing.
HONEYCOMB_API_KEY=
