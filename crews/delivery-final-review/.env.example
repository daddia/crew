# delivery-final-review crew — copy to .env and fill in values
# See src/config.ts for the canonical schema and validation rules.

# ── Identity ──────────────────────────────────────────────────────────────────
# Unique identifier for this crew instance (default: delivery-final-review).
CREW_ID=delivery-final-review

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Structured log level: debug | info | warn | error (default: info).
LOG_LEVEL=info

# ── Infrastructure ────────────────────────────────────────────────────────────
# HTTP port. Default: 3002 (delivery-build=3000, delivery-qa=3001).
PORT=3002
# SQLite database file path.
DB_PATH=./data/delivery-review.db
