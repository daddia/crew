# delivery-build crew — copy to .env and fill in values
# See src/config.ts for the canonical schema and validation rules.

# ── Identity ──────────────────────────────────────────────────────────────────
# Unique identifier for this crew instance (used in logs and provenance).
CREW_ID=delivery-build

# Jira
ATLASSIAN_BASE_URL=https://yourorg.atlassian.net
ATLASSIAN_EMAIL=bot@example.com
# Jira project key polled for new To Do stories (e.g. CREW).
JIRA_PROJECT_KEY=
# Jira account ID of the engineer persona assigned to incoming stories.
JIRA_ASSIGNEE_ACCOUNT_ID=
# Jira custom-field ID for acceptance criteria (e.g. customfield_10042).
JIRA_ACCEPTANCE_CRITERIA_FIELD_ID=
# Optional: Jira account ID of the bot account. When set, comment authorship
# is matched by account ID rather than email (more reliable across Jira contexts).
ATLASSIAN_ACCOUNT_ID=

# GitLab
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_PROJECT_ID=

# ── Behaviour ─────────────────────────────────────────────────────────────────
# All fields below have documented defaults; omit to use the default.

# Claude model routing (optional; defaults shown below).
MODEL_ROUTING_LOW_COST=
MODEL_ROUTING_IMPLEMENTATION=
# Structured log level: debug | info | warn | error (default: info).
LOG_LEVEL=info
# Milliseconds between Jira polling ticks. Default: 300000 (5 minutes).
POLL_INTERVAL_MS=300000
# Maximum peer-review refactor iterations before escalating. Default: 2.
REFACTOR_LOOP_CAP=2
# Maximum CI fix attempts before escalating. Default: 3.
CI_RETRY_CAP=3
# Milliseconds between CI pipeline status polls. Default: 30000.
CI_POLL_INTERVAL_MS=30000
# Maximum milliseconds to wait for a pipeline to settle before escalating. Default: 1800000 (30 minutes).
CI_WAIT_TIMEOUT_MS=1800000
# Hours to wait for PM clarification before escalating. Default: 24.
CLARIFICATION_TIMEOUT_HOURS=24
# Maximum number of files included in a MR diff sent to the agent. Default: 50.
DIFF_FILE_CAP=50
# Maximum byte size of a MR diff sent to the agent. Default: 500000.
DIFF_SIZE_CAP_BYTES=500000

# ── Infrastructure ────────────────────────────────────────────────────────────
# HTTP port. Default: 3000.
PORT=3000
# SQLite database file path. Use /data/delivery-build.db with a Railway volume.
DB_PATH=./data/delivery-build.db
# Absolute path to the repository root used for engineer memory seeding.
PROJECT_DIR=

# ── Secrets ───────────────────────────────────────────────────────────────────
# Do NOT commit real values. Set these as service variables in Railway.
ANTHROPIC_API_KEY=
ATLASSIAN_API_TOKEN=
GITLAB_PERSONAL_ACCESS_TOKEN=
# Minimum 16 characters. Set in both this service and the Jira webhook config.
JIRA_WEBHOOK_SECRET=
# Minimum 16 characters. Set in both this service and the GitLab webhook config.
GITLAB_WEBHOOK_SECRET=
