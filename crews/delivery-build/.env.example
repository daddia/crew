# delivery-build crew — copy to .env and fill in values

# Server
PORT=3000

# Anthropic
ANTHROPIC_API_KEY=
# Claude model to use (optional; uses the SDK default when not set).
ANTHROPIC_MODEL=

# Atlassian / Jira
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
ATLASSIAN_BASE_URL=https://yourorg.atlassian.net
# Jira project key polled for new To Do stories (e.g. CREW).
JIRA_PROJECT_KEY=
# Jira account ID of the engineer assigned to incoming stories.
JIRA_ASSIGNEE_ACCOUNT_ID=

# GitLab
GITLAB_PERSONAL_ACCESS_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_PROJECT_ID=

# Webhook secrets
JIRA_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=

# SQLite file location (relative to crews/delivery-build/)
DB_PATH=./data/delivery.db

# Runtime
# Absolute path to the repository root used for engineer memory seeding.
PROJECT_DIR=

# Workflow
# Milliseconds between Jira polling ticks. Defaults to 300000 (5 minutes).
POLL_INTERVAL_MS=300000
# Maximum number of peer-review refactor iterations before escalating to human review.
REFACTOR_LOOP_CAP=2
# Maximum number of CI fix attempts before escalating to human review.
CI_RETRY_CAP=3
# Milliseconds between CI pipeline status polls.
CI_POLL_INTERVAL_MS=30000
# Hours to wait for a human to respond to clarification questions before
# escalating to Needs Human Review. Defaults to 24.
CLARIFICATION_TIMEOUT_HOURS=24
